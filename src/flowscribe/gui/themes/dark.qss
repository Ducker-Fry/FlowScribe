/* FlowScribe Dark Theme */

QWidget {
    background-color: #111827;
    color: #e5e7eb;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QDialog {
    background-color: #111827;
}

QGroupBox, QFrame[card="true"], QWidget[card="true"] {
    background-color: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
}

QGroupBox {
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #e5e7eb;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton, QToolButton {
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 22px;
}

QPushButton {
    background-color: #374151;
    color: #e5e7eb;
    border: 1px solid #4b5563;
}

QPushButton:hover, QToolButton:hover {
    background-color: #4b5563;
    border-color: #2563eb;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #2563eb;
    color: #ffffff;
}

QPushButton:disabled, QToolButton:disabled {
    color: #6b7280;
}

QPushButton[primary="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
}

QPushButton[secondary="true"] {
    background-color: #374151;
    color: #e5e7eb;
}

QPushButton[cardAction="true"] {
    min-width: 78px;
    padding: 5px 10px;
}

QPushButton[queueCheck="true"] {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    border-radius: 6px;
    border: 1px solid #4b5563;
    background-color: #111827;
    color: transparent;
    font-size: 14px;
    font-weight: 700;
}

QPushButton[queueCheck="true"]:hover {
    border-color: #3b82f6;
    background-color: #1e3a8a;
}

QPushButton[queueCheck="true"]:checked {
    border-color: #2563eb;
    background-color: #2563eb;
    color: #ffffff;
}

QPushButton[queueCheck="true"]:checked:hover {
    border-color: #3b82f6;
    background-color: #1d4ed8;
}

QToolButton[sectionToggle="true"] {
    background-color: #1f2937;
    border: 1px solid #374151;
    font-weight: 600;
    text-align: left;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #111827;
    color: #e5e7eb;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #1d4ed8;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563eb;
}

QComboBox {
    padding-right: 24px;
}

QListWidget {
    background-color: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QListWidget[cardList="true"]::item {
    padding: 4px 4px;
    border: none;
}

QListWidget[cardList="true"]::item:selected {
    background-color: transparent;
    color: #e5e7eb;
}

QWidget[card="true"][selected="true"] {
    background-color: #172554;
    border: 1px solid #3b82f6;
}

QTabWidget::pane {
    border: 1px solid #374151;
    border-radius: 8px;
    background-color: #1f2937;
}

QTabBar::tab {
    background-color: #374151;
    border: 1px solid #4b5563;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background-color: #1f2937;
    color: #ffffff;
    border-color: #2563eb;
}

QProgressBar {
    border: 1px solid #374151;
    border-radius: 6px;
    text-align: center;
    background-color: #111827;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 6px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #374151;
    border-radius: 3px;
    background-color: #111827;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}
