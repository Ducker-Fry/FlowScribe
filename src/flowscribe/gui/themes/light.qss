/* FlowScribe Light Theme */

QWidget {
    background-color: #f9fafb;
    color: #1f2937;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QDialog {
    background-color: #f9fafb;
}

QGroupBox, QFrame[card="true"], QWidget[card="true"] {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QGroupBox {
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #1f2937;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton, QToolButton {
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 22px;
}

QPushButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
}

QPushButton:hover, QToolButton:hover {
    background-color: #e5e7eb;
    border-color: #2563eb;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #2563eb;
    color: #ffffff;
}

QPushButton:disabled, QToolButton:disabled {
    opacity: 0.5;
    color: #6b7280;
}

QPushButton[primary="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
}

QPushButton[primary="true"]:hover {
    background-color: #1d4ed8;
}

QPushButton[secondary="true"] {
    background-color: #f3f4f6;
    color: #1f2937;
}

QToolButton[sectionToggle="true"] {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    font-weight: 600;
    text-align: left;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563eb;
}

QComboBox {
    padding-right: 24px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1f2937;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1f2937;
    border-color: #2563eb;
}

QProgressBar {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    text-align: center;
    background-color: #ffffff;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 6px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}
